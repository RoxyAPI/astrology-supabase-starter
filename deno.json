{
  "workspace": [
    "./supabase/functions"
  ],
  "tasks": {
    "fmt": "deno fmt",
    "lint": "deno fmt --check && deno lint",
    "check": "deno check supabase/functions tests",
    "test": "deno test --allow-read --allow-env --ignore=tests/drift.test.ts tests/",
    "test:drift": "deno test --allow-net --allow-read tests/drift.test.ts",
    "verify": "deno task lint && deno task check && deno task test"
  },
  "fmt": {
    "lineWidth": 110,
    "singleQuote": true,
    "exclude": [
      "demo/"
    ]
  },
  "lint": {
    "exclude": [
      "demo/"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/toml": "jsr:@std/toml@1"
  }
}
